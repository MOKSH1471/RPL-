# ── Backend API ────────────────────────────────────────────────────────
# In local development, defaults to http://localhost:5005/api
# In production on Vercel, set to your live backend URL (e.g. Render / Railway / EC2)
VITE_API_URL=https://rpl-back.onrender.com/api

# ── Razorpay Integration ───────────────────────────────────────────────
# Razorpay Key ID (rzp_test_... for development / testing, rzp_live_... for production)
VITE_RAZORPAY_KEY_ID=rzp_test_TivKrz1oOVPG55

# ── API & Submission ──────────────────────────────────────────────────
# Optional Webhook URL (e.g. Google Apps Script / SheetDB / Express Endpoint)
VITE_SUBMIT_WEBHOOK_URL=

# ── Feature Flags ─────────────────────────────────────────────────────
VITE_ENABLE_ANALYTICS=false
